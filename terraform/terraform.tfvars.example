# Copy this file to terraform.tfvars and fill in your values

# Azure configuration
resource_group_name = "ai-chatbox-map-rg"
location           = "East US"
project_name       = "ai-chatbox-map"

# VM configuration
vm_size           = "Standard_B2s"  # Cost-efficient: 2 vCPUs, 4GB RAM
worker_node_count = 2
admin_username    = "azureuser"

# SSH key (generate with: ssh-keygen -t rsa -b 4096)
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2E... your-ssh-public-key-here"

# API keys (keep these secret!)
gemini_api_key      = "your-gemini-api-key-here"
google_maps_api_key = "your-google-maps-api-key-here"

# Tags
tags = {
  Environment = "production"
  Project     = "ai-chatbox-map"
  ManagedBy   = "terraform"
  Owner       = "your-name"
}